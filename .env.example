# ==============================================================================
# Environment Configuration Example (.env.example)
# Saarthi - Full-Duplex Multilingual Voice AI Concierge
# ==============================================================================

# Speech-to-Text (STT) - Deepgram Nova-3
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# Orchestration & LLM - Groq LPU (Sub-150ms TTFT)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Text-to-Speech (TTS) - Rime API (Coda Flagship)
RIME_API_KEY=your_rime_api_key_here
RIME_MODEL_ID=coda
RIME_VOICE_ID=astra
RIME_HINDI_VOICE=nadi
RIME_SPANISH_VOICE=luz
RIME_FRENCH_VOICE=aurelie
RIME_GERMAN_VOICE=greta

# Optional: LiveKit Agent Gateway (for WebRTC channels)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Local Web Server Configuration
HOST=0.0.0.0
PORT=8000
